# Normalize line endings to LF on all platforms
* text=auto eol=lf

# Shell scripts must always use LF
*.sh text eol=lf

# Config files use LF
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf

# Markdown
*.md text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.pcap binary
